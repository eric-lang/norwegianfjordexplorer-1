---
const decks=[
  {name:'Deck 1',alt:'Retro cabin with wooden berths and a sofa',facilities:['Six double retro-style berths, two with a sink','Storage for clean towels and bed linens','Two toilets and two showers']},
  {name:'Deck 1B',alt:'Wooden bunk beds and a chair in a single cabin',facilities:['Four single berths, all with a sink and bunk']},
  {name:'Deck 2',alt:'Bright cabin with wooden bunks and round portholes',facilities:['Bathroom, two showers and two toilets','Reception with games and toys','Fully equipped galley','Dining / conference room for 50 guests','Small, cosy outdoor deck','One triple cabin']},
  {name:'Deck 2B',alt:'The cosy King Crab Saloon with red seating and wooden tables',facilities:['The King Crab Saloon']},
  {name:'Deck 3',alt:'Cabin with green curtains, bunks and a small seating area',facilities:['Two single and two double cabins','Northern Lights bar and observation deck for 30']},
  {name:'Deck 4',alt:'An onboard buffet with dishes laid out for guests',facilities:['Top deck with barbecue / grill']},
];
---
<section class="deck-plans" id="deck-plans" aria-labelledby="deck-plans-heading">
  <header class="deck-plans__header" data-reveal>
    <p class="deck-plans__label"><span aria-hidden="true"></span>The Vessel</p>
    <div class="deck-plans__introduction"><h2 id="deck-plans-heading">Deck Plan for My<br /><em>Fjord Visjon</em></h2><ul class="deck-plans__capacity"><li>15 Cabins</li><li>24 Beds</li><li>70 Guests / Passengers</li></ul></div>
  </header>
  <div class="deck-plans__grid">
    {decks.map((deck,index)=><article class:list={['deck-card',{'deck-card--reverse':index%2===1}]} data-reveal style={`--reveal-delay:${index%2*100}ms`}>
      <div class="deck-card__photo">
        <img src={`/images/deck-photo-${index+1}.webp`} alt={deck.alt} width="1000" height="1000" loading="lazy" />
        <span class="deck-card__shade" aria-hidden="true"></span>
        <header><p><span aria-hidden="true"></span>Fjord Visjon</p><h3>{deck.name}</h3></header>
        <ul class="deck-card__facilities">{deck.facilities.map(facility=><li>{facility}</li>)}</ul>
      </div>
      <button type="button" class="deck-card__plan" data-deck-name={deck.name} data-plan-src={`/images/deck-plan-${index+1}.webp`} aria-label={`Enlarge ${deck.name} plan`}>
        <img src={`/images/deck-plan-${index+1}.webp`} alt={`${deck.name} layout from the vessel's deck drawing`} width="504" height="1232" loading="lazy" />
        <span aria-hidden="true">↗</span>
      </button>
    </article>)}
  </div>
  <dialog class="deck-plan-dialog" aria-labelledby="deck-plan-dialog-title">
    <header><h3 id="deck-plan-dialog-title">Deck plan</h3><button type="button" aria-label="Close enlarged deck plan">×</button></header>
    <img alt="" width="504" height="1232" />
  </dialog>
</section>
<script>
  const section=document.querySelector<HTMLElement>('.deck-plans');
  const dialog=section?.querySelector<HTMLDialogElement>('dialog');
  if(section&&dialog) {
    const title=dialog.querySelector<HTMLElement>('h3')!;
    const image=dialog.querySelector<HTMLImageElement>('img')!;
    section.querySelectorAll<HTMLButtonElement>('.deck-card__plan').forEach(button=>button.addEventListener('click',()=>{
      title.textContent=`${button.dataset.deckName} — Layout`;
      image.src=button.dataset.planSrc!;
      image.alt=`Enlarged ${button.dataset.deckName} plan`;
      dialog.showModal();
    }));
    dialog.querySelector('button')!.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',event=>{if(event.target===dialog){const bounds=dialog.getBoundingClientRect();if(event.clientX<bounds.left||event.clientX>bounds.right||event.clientY<bounds.top||event.clientY>bounds.bottom)dialog.close();}});
  }
</script>
<style>
  .deck-plans {padding:120px 16px;background:#0f1f38;color:var(--cream);}
  .deck-plans__header {margin-bottom:64px;}
  .deck-plans__label {display:flex;align-items:center;gap:12px;margin:0 0 16px;padding-bottom:16px;border-bottom:1px solid rgb(255 250 231 / .2);font:500 18px/1.5 var(--font-body);}
  .deck-plans__label span {width:10px;height:10px;background:var(--red);}
  .deck-plans__introduction {display:flex;justify-content:space-between;align-items:flex-end;gap:32px;}
  .deck-plans h2 {margin:0;font:400 clamp(42px,5vw,72px)/1.1 Georgia,serif;letter-spacing:-.045em;}
  .deck-plans__capacity {list-style:none;padding:0;margin:0;text-align:right;font:700 18px/1.5 var(--font-body);}
  .deck-plans__capacity li+li {margin-top:10px;}
  .deck-plans__grid {display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .deck-card {display:grid;grid-template-columns:444fr 252fr;height:616px;overflow:hidden;border-radius:5px;min-width:0;}
  .deck-card--reverse {grid-template-columns:252fr 444fr;}
  .deck-card--reverse .deck-card__plan {grid-column:1;grid-row:1;}
  .deck-card__photo {position:relative;overflow:hidden;min-width:0;}
  .deck-card__photo>img {display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.035);transition:transform 800ms cubic-bezier(.22,1,.36,1);}
  .deck-card:hover .deck-card__photo>img {transform:scale(1);}
  .deck-card__shade {position:absolute;inset:0;background:linear-gradient(180deg,rgb(0 0 0 / .3),transparent 40%,rgb(0 0 0 / .4));}
  .deck-card__photo header {position:absolute;top:16px;left:32px;right:16px;}
  .deck-card__photo header p {display:flex;align-items:center;gap:6px;margin:0 0 8px;color:var(--red);font:700 14px/1.5 var(--font-body);text-transform:uppercase;}
  .deck-card__photo header p span {width:10px;height:10px;flex:none;border-radius:50%;background:#fff;}
  .deck-card h3 {margin:0;color:#fff;font:400 40px/1.2 Georgia,serif;letter-spacing:-.045em;}
  .deck-card__facilities {position:absolute;bottom:10px;left:10px;right:10px;margin:0;padding:12px 14px 12px 32px;background:#eae1c1;color:var(--navy);font:700 14px/1.5 var(--font-body);border-radius:2px;}
  .deck-card__facilities li+li {margin-top:8px;}
  .deck-card__plan {position:relative;min-width:0;border:0;padding:0;background:#fff;cursor:zoom-in;overflow:hidden;}
  .deck-card__plan img {display:block;width:100%;height:100%;object-fit:contain;}
  .deck-card__plan>span {position:absolute;bottom:12px;right:12px;background:var(--cream);color:var(--navy);border-radius:50%;width:32px;height:32px;display:grid;place-items:center;opacity:0;transition:opacity 250ms;}
  .deck-card__plan:is(:hover,:focus-visible)>span {opacity:1;}
  .deck-plan-dialog {width:min(540px,calc(100% - 32px));max-height:90svh;padding:16px;border:0;border-radius:8px;background:#fff;color:var(--navy);}
  .deck-plan-dialog::backdrop {background:rgb(0 0 0 / .7);backdrop-filter:blur(4px);}
  .deck-plan-dialog header {display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .deck-plan-dialog h3 {margin:0;font-size:20px;}
  .deck-plan-dialog button {width:40px;height:40px;border:0;border-radius:50%;background:var(--cream);color:var(--navy);font-size:28px;cursor:pointer;}
  .deck-plan-dialog>img {display:block;width:100%;height:auto;}
  @media(max-width:1000px) and (min-width:761px) {.deck-card__photo header {left:16px;}.deck-card__facilities {font-size:12px;padding-left:24px;}.deck-card h3 {font-size:32px;}}
  @media(max-width:760px) {.deck-plans {padding:64px 16px;}.deck-plans__header {margin-bottom:36px;}.deck-plans__label {font-size:14px;}.deck-plans__introduction {align-items:flex-start;flex-direction:column;gap:24px;}.deck-plans__capacity {text-align:left;font-size:16px;}.deck-plans__grid {grid-template-columns:1fr;gap:12px;}.deck-card {height:560px;}.deck-card__photo header {left:16px;}.deck-card h3 {font-size:30px;}.deck-card__photo header p {font-size:11px;}.deck-card__facilities {left:8px;right:8px;bottom:8px;padding:10px 8px 10px 24px;font-size:12px;}.deck-card__facilities li+li {margin-top:6px;}}
  @media(prefers-reduced-motion:reduce) {.deck-card__photo>img,.deck-card__plan>span {transition:none;}}
</style>
