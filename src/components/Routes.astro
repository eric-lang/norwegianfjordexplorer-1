---
import BookingLink from './BookingLink.astro';
import { routeStops } from '../data/route-stops';
const initialStop = routeStops.find(stop => stop.id === 'narvik')!;
const markers = routeStops.filter(stop => !('grouped' in stop) || stop.id === 'stamsund');
---
<section class="routes" id="routes" aria-labelledby="routes-heading">
  <header class="routes__header" data-reveal>
    <p class="routes__eyebrow"><span aria-hidden="true"></span>Routes</p>
    <h2 id="routes-heading">There’s a <em>Fjord</em> in<br />Your Future</h2>
  </header>
  <div class="routes__grid">
    <figure class="routes__map" data-reveal style="--reveal-delay:100ms">
      <div class="route-map__canvas">
      <img src="/images/routes-map.svg" alt="Illustrated Arctic cruise routes along the coast of Northern Norway" width="696" height="724" loading="lazy" />
      {markers.map(stop => <button class="route-map__marker" type="button" data-stop={stop.id} style={`left:${stop.point[0] / 696 * 100}%;top:${stop.point[1] / 724 * 100}%`} aria-label={`Explore ${stop.id === 'stamsund' ? 'Western Lofoten' : stop.name}`} aria-haspopup="dialog" aria-expanded={stop.id === initialStop.id ? 'true' : 'false'} aria-controls="route-stop-details" hidden><span aria-hidden="true"></span></button>)}
      <div class="route-map__popup" id="route-stop-details" role="dialog" aria-modal="false" aria-labelledby="route-stop-title" style={`left:clamp(12px,calc(${initialStop.point[0] / 696 * 100}% - 140px),calc(100% - 292px));bottom:calc(${100 - initialStop.point[1] / 724 * 100}% + 24px)`}>
        <button class="route-map__close" type="button" aria-label="Close location details">×</button>
        <p class="route-map__eyebrow" data-stop-region>{initialStop.region}</p>
        <h3 id="route-stop-title">{initialStop.name}</h3>
        <p data-stop-story>{initialStop.story}</p>
        <a data-stop-source href={initialStop.source} target="_blank" rel="noopener noreferrer"><span data-stop-link-label>Discover {initialStop.name}</span> <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        <button class="route-map__nearby" type="button" data-nearby-stop={initialStop.nearby}>Explore nearby: Harstad <span aria-hidden="true">→</span></button>
      </div>
      </div>
      <label class="route-map__selector" hidden>Explore a stop
        <select aria-label="Explore a route stop">{routeStops.map(stop => <option value={stop.id} selected={stop.id === initialStop.id}>{stop.name}</option>)}</select>
      </label>
      <figcaption class="sr-only">Illustrative routes from the original design. Contact the crew to plan your sailing.</figcaption>
    </figure>
    <div class="routes__card" data-reveal style="--reveal-delay:200ms">
      <h3>Sail and stay a few hours or some days onboard the world’s smallest cruise vessel</h3>
      <div class="routes__details">
        <p>King crab expeditions. Lunch and dinner cruises. Ski and cycle adventures. Northern Lights and Midnight Sun. Explore Lofoten, Vesterålen, Senja and the Lyngen Alps, with polar histories and Arctic experiences along the way.</p>
        <BookingLink />
      </div>
    </div>
  </div>
</section>
<script>
  import { routeStops } from '../data/route-stops';
  const canvas = document.querySelector<HTMLElement>('.route-map__canvas');
  const markers = Array.from(canvas?.querySelectorAll<HTMLButtonElement>('.route-map__marker') ?? []);
  const popup = canvas?.querySelector<HTMLElement>('.route-map__popup');
  const close = canvas?.querySelector<HTMLButtonElement>('.route-map__close');
  const selector = document.querySelector<HTMLSelectElement>('.route-map__selector select');
  if (canvas && markers.length && popup && close && selector) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let popupAnimation: Animation | undefined;
    let active: (typeof routeStops)[number] = routeStops.find(stop => stop.id === 'narvik')!;
    let opened = true;
    function activeMarker() { return markers.find(marker => marker.dataset.stop === ('grouped' in active ? 'stamsund' : active.id))!; }
    markers.forEach(marker => { marker.hidden = false; });
    document.querySelector<HTMLElement>('.route-map__selector')!.hidden = false;
    function positionPopup() {
      if (!canvas || !popup || popup.hidden) return;
      const x = canvas.clientWidth * active.point[0] / 696;
      const y = canvas.clientHeight * active.point[1] / 724;
      const left = Math.max(12, Math.min(x - popup.offsetWidth / 2, canvas.clientWidth - popup.offsetWidth - 12));
      popup.style.left = `${left}px`;
      const below = active.point[1] / 724 < .28;
      popup.dataset.placement = below ? 'below' : 'above';
      popup.style.top = below ? `${y + 24}px` : 'auto';
      popup.style.bottom = below ? 'auto' : `${canvas.clientHeight - y + 24}px`;
      popup.style.setProperty('--arrow-left', `${x - left}px`);
    }
    function dismiss(returnFocus = false) {
      if (!popup || !opened) return;
      const current = getComputedStyle(popup);
      const start = {transform:current.transform, opacity:current.opacity};
      popupAnimation?.cancel();
      opened = false;
      markers.forEach(marker => marker.setAttribute('aria-expanded', 'false'));
      popup.inert = true;
      popup.setAttribute('aria-hidden', 'true');
      if (returnFocus) activeMarker().focus({preventScroll:true});
      if (motion.matches) { popup.hidden = true; return; }
      const animation = popup.animate([start, {transform:'scale(0)', opacity:0}], {duration:220, easing:'cubic-bezier(.4,0,.8,.2)', fill:'forwards'});
      popupAnimation = animation;
      animation.finished.then(() => { if (popupAnimation === animation) { popup.hidden = true; animation.cancel(); popupAnimation = undefined; } }).catch(() => {});
    }
    function showStop(id: string, focus = true) {
      const stop = routeStops.find(stop => stop.id === id);
      if (!stop || !popup || !selector || !close) return;
      active = stop;
      opened = true;
      popupAnimation?.cancel();
      popupAnimation = undefined;
      popup.hidden = false;
      popup.inert = false;
      popup.removeAttribute('aria-hidden');
      markers.forEach(marker => marker.setAttribute('aria-expanded', String(marker === activeMarker())));
      selector.value = stop.id;
      popup.querySelector<HTMLElement>('[data-stop-region]')!.textContent = stop.region;
      popup.querySelector<HTMLElement>('#route-stop-title')!.textContent = stop.name;
      popup.querySelector<HTMLElement>('[data-stop-story]')!.textContent = stop.story;
      popup.querySelector<HTMLAnchorElement>('[data-stop-source]')!.href = stop.source;
      popup.querySelector<HTMLElement>('[data-stop-link-label]')!.textContent = `Discover ${stop.name}`;
      const nearby = popup.querySelector<HTMLButtonElement>('[data-nearby-stop]')!;
      nearby.dataset.nearbyStop = stop.nearby;
      nearby.textContent = `Explore nearby: ${routeStops.find(item => item.id === stop.nearby)!.name} →`;
      positionPopup();
      if (!motion.matches) popupAnimation = popup.animate([
        {transform:'scale(0)', opacity:0},
        {transform:'scale(1.025)', opacity:1, offset:.8},
        {transform:'scale(1)', opacity:1},
      ], {duration:320, easing:'cubic-bezier(.16,1,.3,1)'});
      if (focus) close.focus({preventScroll:true});
    }
    markers.forEach(marker => marker.addEventListener('click', () => {
      if (marker === activeMarker() && opened) { dismiss(); return; }
      showStop(marker.dataset.stop!);
    }));
    selector.addEventListener('change', () => showStop(selector.value, false));
    popup.querySelector('[data-nearby-stop]')?.addEventListener('click', event => {
      showStop((event.currentTarget as HTMLButtonElement).dataset.nearbyStop!);
    });
    close.addEventListener('click', () => dismiss(true));
    document.addEventListener('pointerdown', event => {
      if (opened && event.target instanceof Node && !popup.contains(event.target) && !markers.some(marker => marker.contains(event.target as Node)) && !selector.contains(event.target)) dismiss();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && opened) { event.preventDefault(); dismiss(true); }
    });
    new ResizeObserver(positionPopup).observe(canvas);
    motion.addEventListener('change', () => {
      if (!motion.matches) return;
      popupAnimation?.cancel();
      if (!opened) popup.hidden = true;
    });
    positionPopup();
  }
</script>
<style>
  .routes { padding:110px 16px 120px; background:var(--cream); color:var(--navy); scroll-margin-top:24px; }
  .routes__eyebrow { display:flex; justify-content:flex-end; align-items:center; gap:12px; margin:0 0 24px; padding-bottom:24px; border-bottom:1px solid #ded8c2; font-size:18px; }
  .routes__eyebrow span { width:10px; height:10px; background:var(--red); }
  .routes h2 { margin:0 0 48px; max-width:1050px; color:#1e1e1e; font-family:'PP Pangaia',Georgia,'Times New Roman',serif; font-size:clamp(48px,8.333vw,120px); font-weight:400; line-height:1.1; letter-spacing:-.035em; }
  .routes h2 em { font-weight:700; }
  .routes__grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .routes__map { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; align-items:center; margin:0; background:#8b0505; border-radius:5px; border-top:32px solid #8b0505; border-bottom:32px solid #8b0505; }
  .routes__map img { display:block; width:100%; height:auto; }
  .route-map__canvas { position:relative; width:100%; }
  .route-map__marker { position:absolute; z-index:2; width:24px; height:24px; transform:translate(-50%,-50%); border:0; padding:0; background:transparent; cursor:pointer; border-radius:50%; }
  .route-map__marker:is(:hover,:focus-visible) { z-index:4; }
  .route-map__marker span { display:block; width:15px; height:15px; margin:auto; background:#ffff00; border:2px solid var(--cream); border-radius:50%; box-shadow:0 0 0 6px rgb(255 250 231 / .2); transition:box-shadow 220ms,transform 220ms; }
  .route-map__marker:is(:hover,:focus-visible,[aria-expanded='true']) span { transform:scale(1.15); box-shadow:0 0 0 9px rgb(255 250 231 / .3); }
  .route-map__popup { position:absolute; z-index:3; width:min(280px,calc(100% - 24px)); padding:22px; background:var(--cream); color:var(--navy); border-radius:12px; box-shadow:0 14px 36px rgb(0 0 0 / .25); transform-origin:var(--arrow-left, 50%) calc(100% + 24px); }
  .route-map__popup::after { content:''; position:absolute; left:var(--arrow-left); bottom:-8px; width:16px; height:16px; transform:translateX(-50%) rotate(45deg); background:var(--cream); }
  .route-map__popup[data-placement='below'] { transform-origin:var(--arrow-left,50%) -24px; }
  .route-map__popup[data-placement='below']::after { top:-8px; bottom:auto; }
  .route-map__close { position:absolute; top:8px; right:8px; width:32px; height:32px; border:0; border-radius:50%; background:transparent; color:var(--navy); font-size:25px; cursor:pointer; }
  .route-map__close:hover { background:#eae1c1; }
  .route-map__popup .route-map__eyebrow { margin:0 24px 8px 0; font-size:11px; letter-spacing:.08em; text-transform:uppercase; }
  .route-map__popup h3 { margin:0 0 10px; font-size:30px; line-height:1.1; }
  .route-map__popup p { margin:0 0 16px; font-size:14px; line-height:1.5; }
  .route-map__popup a { display:inline-flex; align-items:center; gap:12px; font-size:13px; font-weight:700; text-decoration:underline; text-underline-offset:4px; }
  .route-map__popup a:hover { color:var(--red); }
  .route-map__nearby { display:block; margin:16px 0 0; padding:12px 0 0; border:0; border-top:1px solid #ded8c2; background:transparent; color:var(--navy); font:600 12px/1.4 var(--font-body); text-align:left; cursor:pointer; }
  .route-map__nearby:hover { color:var(--red); }
  .route-map__selector { display:flex; align-items:center; justify-content:space-between; gap:16px; width:calc(100% - 32px); padding-top:16px; color:var(--cream); font-size:13px; }
  .route-map__selector select { min-width:0; max-width:65%; min-height:44px; border:1px solid rgb(255 250 231 / .45); border-radius:6px; padding:8px 12px; padding-right:calc(12px + 1rem); color:var(--navy); background:var(--cream); }
  [hidden] { display:none !important; }
  @media(prefers-reduced-motion:no-preference) { .route-map__marker span { animation:marker-pulse 2600ms ease-in-out infinite; } @keyframes marker-pulse { 0%,100% {scale:1;translate:0 0;} 50% {scale:1.1;translate:0 -1px;} } }
  @media(prefers-reduced-motion:reduce) { .route-map__marker span {transition:none;} }
  .routes__card { display:flex; flex-direction:column; justify-content:space-between; gap:80px; padding:36px 24px; border-radius:5px; background:#0c1d37; color:white; }
  .routes h3 { font-family:Georgia,serif; font-weight:400; font-size:clamp(28px,2.8vw,40px); line-height:1.35; margin:0; max-width:610px; }
  .routes__details { max-width:500px; }
  .routes__details p { font-size:18px; line-height:1.55; margin:0 0 26px; }
  @media(max-width:760px) { .routes {padding:64px 16px;} .routes__eyebrow {font-size:14px;padding-bottom:16px;margin-bottom:20px;} .routes h2 {margin-bottom:28px;} .routes__grid {grid-template-columns:1fr;gap:12px;} .routes__map {border-width:20px;} .routes__card {padding:28px 20px;gap:64px;} .routes h3 {font-size:30px;} .routes__details p {font-size:16px;} }
</style>
