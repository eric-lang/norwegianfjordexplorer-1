<section class="documentary" id="documentary" aria-labelledby="documentary-heading">
  <header class="documentary__header">
    <h2 id="documentary-heading" data-reveal>The Boat and Its Crew<br />Have Their Own</h2>
    <p class="documentary__label" data-reveal><span aria-hidden="true"></span>About</p>
  </header>
  <div id="documentary-film" class="documentary__film" data-reveal>
    <img class="documentary__poster" src="/images/arctic-fjord.webp" alt="The explorer vessel cruising between dramatic Norwegian islands" width="1006" height="713" loading="lazy" />
    <span class="documentary__shade" aria-hidden="true"></span>
    <button class="documentary__play" type="button" aria-label="Play the original Oppdrag Sognefjorden trailer">
      <svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M13 9.5c0-1.6 1.8-2.6 3.2-1.7l16 10.5a2 2 0 0 1 0 3.4l-16 10.5c-1.4.9-3.2-.1-3.2-1.7z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <footer class="documentary__footer" data-reveal>
    <a href="#documentary-film">Watch the original trailer <span aria-hidden="true">↗</span></a>
    <p>International<br />Documentary</p>
  </footer>
</section>
<script>
  const film=document.querySelector<HTMLElement>('.documentary__film');
  const play=film?.querySelector<HTMLButtonElement>('.documentary__play');
  play?.addEventListener('click',()=>{
    if(!film)return;
    const player=document.createElement('iframe');
    player.src='https://player.vimeo.com/video/19972686?autoplay=1&title=0&byline=0&portrait=0&dnt=1';
    player.title='Oppdrag Sognefjorden — original documentary trailer by Flash Studio';
    player.allow='autoplay; fullscreen; picture-in-picture';
    player.allowFullscreen=true;
    player.referrerPolicy='strict-origin-when-cross-origin';
    film.append(player);
    play.hidden=true;
    player.focus({preventScroll:true});
  },{once:true});
</script>
<style>
  .documentary {padding:7.5rem 0.625rem;background:var(--cream);color:var(--navy);}
  .documentary__header {display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:3rem;}
  .documentary h2 {margin:0;max-width:53.125rem;font:400 clamp(2.625rem,5vw,4.5rem)/1.1 Georgia,serif;letter-spacing:-.045em;color:#1e1e1e;}
  .documentary__label {display:flex;align-items:center;gap:0.75rem;margin:0;font:500 1.125rem/1.5 var(--font-body);}
  .documentary__label span {width:0.625rem;height:0.625rem;background:var(--red);}
  .documentary__film {position:relative;aspect-ratio:1420/738;overflow:hidden;border-radius:0.3125rem;background:var(--navy);}
  .documentary__poster {display:block;width:100%;height:100%;object-fit:cover;}
  .documentary__shade {position:absolute;inset:0;background:rgb(0 0 0 / .32);pointer-events:none;}
  .documentary__play {position:absolute;top:50%;left:50%;translate:-50% -50%;display:grid;place-items:center;width:5.625rem;height:5.625rem;border:0.125rem solid #d9d9d9;border-radius:50%;padding:0;background:rgb(255 255 255 / .16);color:#d9d9d9;backdrop-filter:blur(0.25rem);cursor:pointer;transition:background 250ms,color 250ms,scale 250ms;}
  .documentary__play svg {width:2.4375rem;height:2.4375rem;}
  .documentary__play:hover {background:var(--cream);color:var(--navy);scale:1.08;}
  .documentary__film :global(iframe) {position:absolute;inset:0;width:100%;height:100%;border:0;background:#000;}
  .documentary__footer {display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-top:3rem;}
  .documentary__footer p {margin:0;text-align:right;font:400 clamp(3rem,8.333vw,7.5rem)/1 Georgia,serif;letter-spacing:-.045em;}
  .documentary__footer a {flex-shrink:0;font-size:0.875rem;font-weight:700;text-underline-offset:0.3125rem;}
  .documentary__footer a:hover {color:var(--red);}
  [hidden] {display:none!important;}
  @media(max-width:47.5rem) {.documentary {padding:4rem 1rem;}.documentary__header {flex-direction:column-reverse;gap:1.5rem;margin-bottom:2rem;}.documentary__label {align-self:flex-end;font-size:0.875rem;}.documentary h2 {font-size:clamp(2.25rem,7.5vw,3.25rem);}.documentary__film {aspect-ratio:4/3;}.documentary__play {width:4rem;height:4rem;}.documentary__play svg {width:1.8125rem;height:1.8125rem;}.documentary__footer {flex-direction:column-reverse;align-items:flex-end;gap:1.5rem;margin-top:2rem;}.documentary__footer p {font-size:clamp(2.375rem,9vw,4rem);}}
  @media(prefers-reduced-motion:reduce) {.documentary__play {transition:none;}}
</style>
