---
import Arrow from './Arrow.astro';
interface Props { variant?: 'cream' | 'red'; hover?: 'navy'; class?: string; }
const { variant = 'cream', hover, class: className } = Astro.props;
---

<a class:list={['booking-link', `booking-link--${variant}`, { 'booking-link--hover-navy': hover === 'navy' }, className]} href="#contact" aria-label="Book now — contact Norwegian Fjord Explorer">
  <span class="booking-link__arrow booking-link__arrow--leading" aria-hidden="true"><Arrow /></span>
  <span class="booking-link__label">Book Now</span>
  <span class="booking-link__arrow booking-link__arrow--trailing" aria-hidden="true"><Arrow /></span>
</a>

<style>
  .booking-link {--cta-height:2.75rem;--cta-background:var(--cream);--cta-color:var(--navy);position:relative;isolation:isolate;display:inline-flex;align-items:center;flex:none;width:9.75rem;height:var(--cta-height);color:var(--cta-color);text-decoration:none;transition:color 250ms ease;}
  .booking-link__label {position:relative;z-index:2;display:grid;place-items:center;width:7rem;flex:none;height:var(--cta-height);padding:0 1.4375rem;border-radius:62.4375rem;background:var(--cta-background);font:700 0.8125rem/1 var(--font-body);white-space:nowrap;pointer-events:none;transition:background-color 250ms ease,transform 480ms cubic-bezier(.22,1,.36,1);}
  .booking-link__arrow {position:absolute;top:0;right:0;display:grid;place-items:center;width:var(--cta-height);height:var(--cta-height);border-radius:50%;background:var(--cta-background);pointer-events:none;transition:background-color 250ms ease,transform 480ms cubic-bezier(.22,1,.36,1),opacity 250ms ease;}
  .booking-link__arrow--leading {left:0;right:auto;transform:scale(.65);opacity:0;visibility:hidden;}
  .booking-link__arrow--trailing {transform:scale(1);opacity:1;visibility:visible;}
  .booking-link:is(:hover,:focus-visible) .booking-link__label {transform:translateX(var(--cta-height));}
  .booking-link:is(:hover,:focus-visible) .booking-link__arrow--leading {transform:scale(1);opacity:1;visibility:visible;}
  .booking-link:is(:hover,:focus-visible) .booking-link__arrow--trailing {transform:scale(.65);opacity:0;visibility:hidden;}
  .booking-link__arrow :global(svg) {display:block;width:1.125rem;height:1.125rem;}
  .booking-link--red {--cta-background:var(--red);--cta-color:var(--cream);}
  .booking-link:is(:hover,:focus-visible) {--cta-background:var(--red);--cta-color:var(--cream);}
  .booking-link--red:is(:hover,:focus-visible) {--cta-background:var(--cream);--cta-color:var(--navy);}
  .booking-link--hover-navy:is(:hover,:focus-visible) {--cta-background:var(--navy);--cta-color:var(--cream);}
  @media(prefers-reduced-motion:reduce) {.booking-link,.booking-link__label,.booking-link__arrow {transition:none;}}
</style>
