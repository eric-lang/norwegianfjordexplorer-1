---
const charters=[
  {title:'Adventure Cruise to Lofoten & Lyngsalpene With Bike or Ski',alt:'View over the blue fjord and coastal landscape of Northern Norway',description:'Bring your sense of adventure. Talk with the crew about combining days on the water with cycling or skiing ashore.'},
  {title:'On the Loose Between Tromsø, Senja, Vesterålen, Lofoten',alt:'Guests carrying skis along a snowy waterfront before an Arctic adventure',description:'Make the journey your own. Plan a private cruise through the islands and fjords with Captain Mads and his team.'},
];
---
<section class="charters" id="charters" aria-labelledby="charters-heading">
  <header class="charters__header" data-reveal>
    <p class="charters__label"><span aria-hidden="true"></span>Charter</p>
    <h2 id="charters-heading">Charter Possibilities</h2>
  </header>
  <div class="charters__grid">
    {charters.map((charter,index)=><a class="charter-card" href="#contact" aria-label={`${charter.title} — enquire about your charter`} data-reveal style={`--reveal-delay:${index*100}ms`}>
      <img src={`/images/charter-${index+1}.webp`} alt={charter.alt} width="1100" height="790" loading="lazy" />
      <span class="charter-card__shade" aria-hidden="true"></span>
      <span class="charter-card__arrow" aria-hidden="true">↗</span>
      <div class="charter-card__caption">
        <p class="charter-card__label"><span aria-hidden="true"></span>Charter</p>
        <h3>{charter.title}</h3>
        <div class="charter-card__extra"><p>{charter.description}</p><span>Plan Your Charter <span aria-hidden="true">↗</span></span></div>
      </div>
    </a>)}
  </div>
</section>
<style>
  .charters {padding:7.5rem 1rem;background:var(--cream);color:var(--navy);}
  .charters__header {margin-bottom:5rem;}
  .charters__label {display:flex;justify-content:flex-end;align-items:center;gap:0.75rem;margin:0 0 2.5rem;padding-bottom:1rem;border-bottom:0.0625rem solid rgb(27 54 97 / .25);font:500 1.125rem/1.5 var(--font-body);}
  .charters__label span {width:0.625rem;height:0.625rem;background:var(--red);}
  .charters h2 {margin:0;color:#1e1e1e;font:400 clamp(2.625rem,5vw,4.5rem)/1.05 Georgia,serif;letter-spacing:-.045em;}
  .charters__grid {display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
  .charter-card {position:relative;display:block;height:31.25rem;overflow:hidden;border-radius:0.3125rem;color:#fff;text-decoration:none;background:var(--navy);}
  .charter-card img {width:100%;height:100%;display:block;object-fit:cover;transform:scale(1.05);transition:transform 850ms cubic-bezier(.22,1,.36,1);}
  .charter-card__shade {position:absolute;inset:0;background:linear-gradient(180deg,rgb(0 0 0 / .3),rgb(0 0 0 / .2) 35%,rgb(0 0 0 / .7));transition:background-color 400ms;}
  .charter-card__caption {position:absolute;left:1.5rem;right:1.5rem;bottom:1.5rem;}
  .charter-card__label {display:flex;align-items:center;gap:0.375rem;margin:0 0 0.5rem;color:var(--red);font:700 0.875rem/1.5 var(--font-body);text-transform:uppercase;}
  .charter-card__label span {width:0.625rem;height:0.625rem;background:#fff;border-radius:50%;}
  .charter-card h3 {margin:0;font:400 2.5rem/1.2 Georgia,serif;letter-spacing:-.045em;}
  .charter-card__arrow {position:absolute;top:1.5rem;right:1.5rem;display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:50%;background:var(--cream);color:var(--navy);font-size:1.5rem;opacity:0;transform:translateY(0.5rem);transition:opacity 350ms,transform 350ms;}
  .charter-card__extra {opacity:0;max-height:0;overflow:hidden;transition:max-height 500ms cubic-bezier(.22,1,.36,1),opacity 350ms;}
  .charter-card__extra p {margin:1rem 0 0.75rem;font:500 1rem/1.5 var(--font-body);}
  .charter-card__extra>span {font-size:0.875rem;font-weight:700;}
  .charter-card:is(:hover,:focus-visible) img {transform:scale(1);}
  .charter-card:is(:hover,:focus-visible) .charter-card__shade {background-color:rgb(0 0 0 / .15);}
  .charter-card:is(:hover,:focus-visible) .charter-card__arrow {opacity:1;transform:none;}
  .charter-card:is(:hover,:focus-visible) .charter-card__extra {max-height:11.25rem;opacity:1;}
  @media(max-width:47.5rem) {.charters {padding:4rem 1rem;}.charters__header {margin-bottom:2.25rem;}.charters__label {font-size:0.875rem;margin-bottom:1.5rem;}.charters__grid {grid-template-columns:1fr;gap:0.75rem;}.charter-card {height:28.75rem;}.charter-card__caption {left:1.25rem;right:1.25rem;bottom:1.25rem;}.charter-card h3 {font-size:1.875rem;}.charter-card__extra p {font-size:0.875rem;}}
  @media(hover:none) {.charter-card__extra {max-height:11.25rem;opacity:1;}.charter-card__arrow {opacity:1;transform:none;}}
  @media(prefers-reduced-motion:reduce) {.charter-card img,.charter-card__shade,.charter-card__arrow,.charter-card__extra {transition:none;}}
</style>
