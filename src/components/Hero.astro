---
import BookingLink from './BookingLink.astro';

const navigation = ['Experiences', 'About', 'Vessel', 'Blog'];
const destinations = [
  { label: 'Tromsø', tab: 'tromso' },
  { label: 'Lofoten & Vesterålen', tab: 'lofoten' },
  { label: 'Special Cruises', tab: 'special' },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <img class="hero__image" src="/images/arctic-fjord.webp" alt="An expedition ship cruising through a dramatic Norwegian fjord" width="1006" height="713" fetchpriority="high" loading="eager" />
  <div class="hero__shade" aria-hidden="true"></div>

  <header class="site-header">
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((label) => label === 'Experiences' ? <a href="#experiences" data-experience-tab="tromso">{label}</a> : label === 'About' ? <a href="#about" data-menu-link>{label}</a> : label === 'Vessel' ? <a href="#vessel" data-menu-link>{label}</a> : <button type="button" data-preview-label={label}>{label}</button>)}
    </nav>
    <a class="site-logo" href="/" aria-label="Norwegian Fjord Explorer home">
      <img src="/images/explorer-logo.png" alt="Norwegian Explorer" width="53" height="53" />
    </a>
    <div class="header-booking"><BookingLink /></div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
    <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
      {navigation.map((label) => label === 'Experiences' ? <a href="#experiences" data-experience-tab="tromso" data-menu-link>{label}</a> : label === 'About' ? <a href="#about" data-menu-link>{label}</a> : label === 'Vessel' ? <a href="#vessel" data-menu-link>{label}</a> : <button type="button" data-preview-label={label}>{label}</button>)}
    </nav>
  </header>

  <div class="hero__content">
    <div class="hero__destinations">
      <nav aria-label="Cruise destinations">
        {destinations.map((destination) => <a href="#experiences" data-experience-tab={destination.tab}>{destination.label}</a>)}
      </nav>
      <BookingLink variant="red" />
    </div>
    <div class="hero__intro">
      <h1 id="hero-heading">
        <span class="sr-only">Authentic Arctic Cruise in Norway</span>
        <span class="hero__heading-line"><img class="hero__heading-art" src="/images/hero-heading-line-1.svg" alt="" width="713" height="105" aria-hidden="true" /></span>
        <span class="hero__heading-line"><img class="hero__heading-art" src="/images/hero-heading-line-2.svg" alt="" width="713" height="105" aria-hidden="true" /></span>
      </h1>
      <p>More than just a boat, TROMSØ Trips offers authentic Arctic cruise in Norway experiences with a unique restaurant, bar, and kitchen on board.</p>
    </div>
  </div>
</section>

<dialog class="section-dialog" aria-labelledby="section-dialog-title">
  <button class="section-dialog__close" type="button" aria-label="Close dialog">×</button>
  <p class="section-dialog__eyebrow">Norwegian Fjord Explorer</p>
  <h2 id="section-dialog-title"></h2>
  <p>This section is coming next. In the meantime, speak with our team to plan your Arctic cruise.</p>
  <a class="section-dialog__phone" href="tel:+4794791130">Call +47 947 91 130 <span aria-hidden="true">↗</span></a>
</dialog>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const dialog = document.querySelector<HTMLDialogElement>('.section-dialog');
  const dialogTitle = document.querySelector<HTMLElement>('#section-dialog-title');

  function closeMenu() {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Open menu');
    mobileMenu.hidden = true;
  }

  menuToggle?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    mobileMenu.hidden = isOpen;
  });
  document.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', closeMenu));

  document.querySelectorAll<HTMLButtonElement>('[data-preview-label]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !dialogTitle) return;
      closeMenu();
      dialogTitle.textContent = button.dataset.previewLabel ?? '';
      dialog.showModal();
    });
  });

  document.querySelector('.section-dialog__close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
  window.matchMedia('(min-width: 761px)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
</script>

<style>
  .hero { position: relative; isolation: isolate; min-height: 720px; height: max(100svh, 70.833333vw); max-height: 1300px; color: white; overflow: hidden; background: #152d32; }
  .hero__image, .hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .hero__image { object-fit: cover; object-position: center; }
  .hero__shade { background: linear-gradient(180deg, rgba(0, 0, 0, .63) 0%, rgba(0, 0, 0, .3) 46%, rgba(0, 0, 0, .52) 100%); }
  .site-header { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 14px 16px; min-height: 81px; }
  .desktop-nav { display: flex; gap: 24px; align-items: center; }
  .desktop-nav :is(button, a), .mobile-nav :is(button, a), .hero__destinations :is(button, a) { appearance: none; border: 0; background: transparent; color: inherit; padding: 0; cursor: pointer; text-align: left; text-decoration: none; }
  .desktop-nav :is(button, a) { font-size: 18px; font-weight: 500; letter-spacing: -.01em; }
  .desktop-nav :is(button, a), .hero__destinations a { position: relative; width: max-content; transition: color 250ms ease; }
  .desktop-nav :is(button, a)::after, .hero__destinations a::after { content: ''; position: absolute; left: 0; bottom: -6px; width: 100%; height: 1px; background: var(--cream); transform: scaleX(0); transform-origin: right; transition: transform 350ms cubic-bezier(.22, 1, .36, 1); }
  .desktop-nav :is(button, a):is(:hover, :focus-visible), .hero__destinations a:is(:hover, :focus-visible) { color: var(--cream); }
  .desktop-nav :is(button, a):is(:hover, :focus-visible)::after, .hero__destinations a:is(:hover, :focus-visible)::after { transform: scaleX(1); transform-origin: left; }
  .site-logo { display: block; line-height: 0; }
  .site-logo img { display: block; width: 53px; height: 53px; }
  .header-booking { display: flex; justify-self: end; }
  .menu-toggle, .mobile-nav { display: none; }
  .hero__content { position: absolute; left: 16px; right: 16px; bottom: 74px; display: grid; grid-template-columns: 1fr min(50.64%, 920px); gap: 10px; align-items: stretch; }
  .hero__destinations { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; padding: 18px 0 0; }
  .hero__destinations nav { display: flex; flex-direction: column; gap: 16px; }
  .hero__destinations :is(button, a) { font-family: var(--font-body); font-size: clamp(15px, 1.326vw, 22px); font-weight: 600; text-transform: uppercase; letter-spacing: -.035em; line-height: 1.4; }
  .hero__intro h1 { margin: 0; font-weight: 400; }
  .hero__heading-art { width: 100%; height: auto; display: block; }
  .hero__heading-line { display: block; }
  .hero__intro p { margin: 32px 0 0; max-width: 713px; font-size: clamp(16px, 1.25vw, 21px); font-weight: 400; line-height: 1.5; letter-spacing: -.015em; }
  .section-dialog { width: min(480px, calc(100% - 32px)); padding: 40px; border: 0; border-radius: 16px; background: var(--cream); color: var(--navy); }
  .section-dialog::backdrop { background: rgb(0 0 0 / .65); backdrop-filter: blur(4px); }
  .section-dialog__close { position: absolute; top: 10px; right: 16px; border: 0; background: transparent; font-size: 32px; color: inherit; cursor: pointer; }
  .section-dialog__eyebrow { font-size: 12px; text-transform: uppercase; letter-spacing: .1em; }
  .section-dialog h2 { margin: 18px 0; font-family: Georgia, serif; font-size: 36px; font-weight: 400; }
  .section-dialog p { line-height: 1.6; }
  .section-dialog__phone { display: inline-block; margin-top: 12px; font-weight: 700; text-underline-offset: 5px; }
  @media (min-width: 1800px) { .site-header { padding-inline: 32px; } .hero__content { left: 32px; right: 32px; } }
  @media (max-width: 1000px) { .desktop-nav { gap: 18px; } .desktop-nav :is(button, a) { font-size: 15px; } .hero__content { grid-template-columns: 1fr 60%; } }
  @media (max-width: 760px) {
    .hero { min-height: 780px; height: 100svh; max-height: none; }
    .hero__image { object-position: 46% center; }
    .hero__shade { background: linear-gradient(180deg, rgb(0 0 0 / .5), rgb(0 0 0 / .15) 30%, rgb(0 0 0 / .65) 85%); }
    .site-header { padding: 16px 20px; grid-template-columns: auto 1fr auto; gap: 16px; }
    .desktop-nav { display: none; }
    .site-logo img { width: 48px; height: 48px; }
    .header-booking { justify-self: end; }
    .menu-toggle { display: flex; flex-direction: column; justify-content: center; gap: 6px; width: 40px; height: 44px; padding: 8px; border: 0; color: inherit; background: transparent; cursor: pointer; }
    .menu-toggle span { display: block; width: 24px; height: 1.5px; background: currentColor; transition: transform 180ms ease; }
    .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
    .mobile-nav:not([hidden]) { display: flex; position: absolute; top: 88px; left: 20px; right: 20px; z-index: 5; flex-direction: column; gap: 8px; padding: 24px; color: var(--navy); background: var(--cream); border-radius: 18px; box-shadow: 0 24px 60px rgb(0 0 0 / .3); transform-origin: top right; }
    .mobile-nav :is(button, a) { position: relative; display: block; font-size: 24px; padding: 14px 12px; border-radius: 8px; transition: background-color 250ms ease, padding-left 350ms ease; }
    .mobile-nav :is(button, a)::after { content: '↗'; position: absolute; right: 12px; opacity: 0; transition: opacity 250ms ease; }
    .mobile-nav :is(button, a):is(:hover, :focus-visible) { background: #eae1c1; padding-left: 20px; }
    .mobile-nav :is(button, a):is(:hover, :focus-visible)::after { opacity: 1; }
    .hero__content { left: 24px; right: 24px; bottom: max(36px, env(safe-area-inset-bottom)); display: flex; flex-direction: column-reverse; gap: 34px; }
    .hero__intro p { margin-top: 22px; font-size: 16px; max-width: 520px; line-height: 1.6; }
    .hero__destinations { padding: 0; gap: 28px; }
    .hero__destinations nav { gap: 10px; }
    .hero__destinations :is(button, a) { font-size: 14px; letter-spacing: 0; }
  }
  @media (max-width: 380px) { .site-header { padding-inline: 16px; gap: 10px; } .hero__content { left: 20px; right: 20px; } }
  @media (prefers-reduced-motion: reduce) { .menu-toggle span, .mobile-nav :is(button, a), .mobile-nav :is(button, a)::after, .desktop-nav :is(button, a), .desktop-nav :is(button, a)::after, .hero__destinations a, .hero__destinations a::after { transition: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .site-logo, .header-booking { animation: hero-enter 700ms cubic-bezier(.22, 1, .36, 1) both; }
    .desktop-nav > :is(button, a) { animation: nav-item-enter 1000ms cubic-bezier(.16, 1, .3, 1) both; }
    .desktop-nav > :nth-child(1) { animation-delay: 100ms; }
    .desktop-nav > :nth-child(2) { animation-delay: 220ms; }
    .desktop-nav > :nth-child(3) { animation-delay: 340ms; }
    .desktop-nav > :nth-child(4) { animation-delay: 460ms; }
    .mobile-nav:not([hidden]) { animation: menu-open 650ms cubic-bezier(.16, 1, .3, 1) both; }
    .mobile-nav:not([hidden]) > :is(button, a) { animation: menu-item-enter 750ms cubic-bezier(.16, 1, .3, 1) both; }
    .mobile-nav > :nth-child(1) { animation-delay: 140ms; }
    .mobile-nav > :nth-child(2) { animation-delay: 220ms; }
    .mobile-nav > :nth-child(3) { animation-delay: 300ms; }
    .mobile-nav > :nth-child(4) { animation-delay: 380ms; }
    .header-booking { animation-delay: 160ms; }
    .hero__heading-line { animation: hero-enter 900ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__heading-line:nth-of-type(2) { animation-delay: 280ms; }
    .hero__heading-line:nth-of-type(3) { animation-delay: 400ms; }
    .hero__intro p { animation: hero-enter 850ms 520ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__destinations nav a { animation: hero-enter 700ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__destinations nav a:nth-child(1) { animation-delay: 440ms; }
    .hero__destinations nav a:nth-child(2) { animation-delay: 520ms; }
    .hero__destinations nav a:nth-child(3) { animation-delay: 600ms; }
    .hero__destinations > :global(.booking-link) { animation: hero-enter 750ms 700ms cubic-bezier(.22, 1, .36, 1) both; }
  }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes nav-item-enter { from { opacity: 0; transform: translateY(-36px); filter: blur(8px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  @keyframes menu-open { from { opacity: 0; clip-path: inset(0 0 100% 35% round 18px); transform: translateY(-12px) scale(.94); } to { opacity: 1; clip-path: inset(0 0 0 0 round 18px); transform: translateY(0) scale(1); } }
  @keyframes menu-item-enter { from { opacity: 0; transform: translateY(28px); filter: blur(5px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
</style>

