---
import BookingLink from './BookingLink.astro';

const navigation = ['Experiences', 'About', 'Vessel', 'Stories'];
const destinations = [
  { label: 'Tromsø', tab: 'tromso' },
  { label: 'Lofoten & Vesterålen', tab: 'lofoten' },
  { label: 'Special Cruises', tab: 'special' },
];
---

<section id="home" class="hero" aria-labelledby="hero-heading">
  <img class="hero__image" src="/images/arctic-fjord.webp" alt="An expedition ship cruising through a dramatic Norwegian fjord" width="1006" height="713" fetchpriority="high" loading="eager" />
  <div class="hero__shade" aria-hidden="true"></div>

  <header class="site-header">
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((label) => label === 'Experiences' ? <a href="#experiences" data-experience-tab="tromso">{label}</a> : label === 'About' ? <a href="#about" data-menu-link>{label}</a> : label === 'Vessel' ? <a href="#vessel" data-menu-link>{label}</a> : <a href="#documentary" data-menu-link>{label}</a>)}
    </nav>
    <a class="site-logo" href="#home" aria-label="Norwegian Fjord Explorer home">
      <img src="/images/explorer-logo.png" alt="Norwegian Explorer" width="53" height="53" />
    </a>
    <div class="header-booking"><BookingLink /></div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
    <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
      {navigation.map((label) => label === 'Experiences' ? <a href="#experiences" data-experience-tab="tromso" data-menu-link>{label}</a> : label === 'About' ? <a href="#about" data-menu-link>{label}</a> : label === 'Vessel' ? <a href="#vessel" data-menu-link>{label}</a> : <a href="#documentary" data-menu-link>{label}</a>)}
    </nav>
  </header>

  <div class="hero__content">
    <div class="hero__destinations">
      <nav aria-label="Cruise destinations">
        {destinations.map((destination) => <a href="#experiences" data-experience-tab={destination.tab}>{destination.label}</a>)}
      </nav>
      <BookingLink variant="red" />
    </div>
    <div class="hero__intro">
      <h1 id="hero-heading">
        
        <span class="hero__heading-line">Authentic Arctic</span>
        <span class="hero__heading-line">Cruise In Norway</span>
      </h1>
      <p>More than just a boat, TROMSØ Trips offers authentic Arctic cruise in Norway experiences with a unique restaurant, bar, and kitchen on board.</p>
    </div>
  </div>
</section>

<dialog class="section-dialog" aria-labelledby="section-dialog-title">
  <button class="section-dialog__close" type="button" aria-label="Close dialog">×</button>
  <p class="section-dialog__eyebrow">Norwegian Fjord Explorer</p>
  <h2 id="section-dialog-title"></h2>
  <p>This section is coming next. In the meantime, speak with our team to plan your Arctic cruise.</p>
  <a class="section-dialog__phone" href="#contact">Call +47 947 91 130 <span aria-hidden="true">↗</span></a>
</dialog>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const dialog = document.querySelector<HTMLDialogElement>('.section-dialog');
  const dialogTitle = document.querySelector<HTMLElement>('#section-dialog-title');

  function closeMenu() {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Open menu');
    mobileMenu.hidden = true;
  }

  menuToggle?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    mobileMenu.hidden = isOpen;
  });
  document.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', closeMenu));

  document.querySelectorAll<HTMLButtonElement>('[data-preview-label]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !dialogTitle) return;
      closeMenu();
      dialogTitle.textContent = button.dataset.previewLabel ?? '';
      dialog.showModal();
    });
  });

  document.querySelector('.section-dialog__close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
  window.matchMedia('(min-width: 47.5625rem)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
</script>

<style>
  .hero { position: relative; isolation: isolate; height: 100vh; color: white; overflow: hidden; background: #152d32; }
  .hero__image, .hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .hero__image { object-fit: cover; object-position: center; }
  .hero__shade { background: linear-gradient(180deg, rgba(0, 0, 0, .63) 0%, rgba(0, 0, 0, .3) 46%, rgba(0, 0, 0, .52) 100%); }
  .site-header { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0.875rem 1rem; min-height: 5.0625rem; }
  .desktop-nav { display: flex; gap: 1.5rem; align-items: center; }
  .desktop-nav :is(button, a), .mobile-nav :is(button, a), .hero__destinations :is(button, a) { appearance: none; border: 0; background: transparent; color: inherit; padding: 0; cursor: pointer; text-align: left; text-decoration: none; }
  .desktop-nav :is(button, a) { font-size: 1.125rem; font-weight: 500; letter-spacing: -.01em; }
  .desktop-nav :is(button, a), .hero__destinations a { position: relative; width: max-content; transition: color 250ms ease; }
  .desktop-nav :is(button, a)::after, .hero__destinations a::after { content: ''; position: absolute; left: 0; bottom: -0.375rem; width: 100%; height: 0.0625rem; background: var(--cream); transform: scaleX(0); transform-origin: right; transition: transform 350ms cubic-bezier(.22, 1, .36, 1); }
  .desktop-nav :is(button, a):is(:hover, :focus-visible), .hero__destinations a:is(:hover, :focus-visible) { color: var(--cream); }
  .desktop-nav :is(button, a):is(:hover, :focus-visible)::after, .hero__destinations a:is(:hover, :focus-visible)::after { transform: scaleX(1); transform-origin: left; }
  .site-logo { display: block; line-height: 0; }
  .site-logo img { display: block; width: 3.3125rem; height: 3.3125rem; }
  .header-booking { display: flex; justify-self: end; }
  .menu-toggle, .mobile-nav { display: none; }
  .hero__content { position: absolute; left: 1rem; right: 1rem; bottom: 4.625rem; display: grid; grid-template-columns: 1fr min(50.64%, 57.5rem); gap: 0.625rem; align-items: stretch; }
  .hero__destinations { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; padding: 1.125rem 0 0; }
  .hero__destinations nav { display: flex; flex-direction: column; gap: 1rem; }
  .hero__destinations :is(button, a) { font-family: var(--font-body); font-size: clamp(0.9375rem, 1.326vw, 1.375rem); font-weight: 600; text-transform: uppercase; letter-spacing: -.035em; line-height: 1.4; }
  .hero__intro h1 { margin: 0; font:400 clamp(2.75rem,6.65vw,8rem)/1.1 Georgia,"Times New Roman",serif; letter-spacing:-.05em; }
  .hero__heading-line { display: block; }
  .hero__intro p { margin: 2rem 0 0; max-width: 44.5625rem; font-size: clamp(1rem, 1.25vw, 1.3125rem); font-weight: 400; line-height: 1.5; letter-spacing: -.015em; }
  .section-dialog { width: min(30rem, calc(100% - 2rem)); padding: 2.5rem; border: 0; border-radius: 1rem; background: var(--cream); color: var(--navy); }
  .section-dialog::backdrop { background: rgb(0 0 0 / .65); backdrop-filter: blur(0.25rem); }
  .section-dialog__close { position: absolute; top: 0.625rem; right: 1rem; border: 0; background: transparent; font-size: 2rem; color: inherit; cursor: pointer; }
  .section-dialog__eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .1em; }
  .section-dialog h2 { margin: 1.125rem 0; font-family: Georgia, serif; font-size: 2.25rem; font-weight: 400; }
  .section-dialog p { line-height: 1.6; }
  .section-dialog__phone { display: inline-block; margin-top: 0.75rem; font-weight: 700; text-underline-offset: 0.3125rem; }
  @media (min-width: 112.5rem) { .site-header { padding-inline: 2rem; } .hero__content { left: 2rem; right: 2rem; } }
  @media (max-width: 62.5rem) { .desktop-nav { gap: 1.125rem; } .desktop-nav :is(button, a) { font-size: 0.9375rem; } .hero__content { grid-template-columns: 1fr 60%; } }
  @media (max-width: 47.5rem) {
    .hero { height: 100vh; }
    .hero__image { object-position: 46% center; }
    .hero__shade { background: linear-gradient(180deg, rgb(0 0 0 / .5), rgb(0 0 0 / .15) 30%, rgb(0 0 0 / .65) 85%); }
    .site-header { padding: 1rem 1.25rem; grid-template-columns: auto 1fr auto; gap: 1rem; }
    .desktop-nav { display: none; }
    .site-logo img { width: 3rem; height: 3rem; }
    .header-booking { justify-self: end; }
    .menu-toggle { display: flex; flex-direction: column; justify-content: center; gap: 0.375rem; width: 2.5rem; height: 2.75rem; padding: 0.5rem; border: 0; color: inherit; background: transparent; cursor: pointer; }
    .menu-toggle span { display: block; width: 1.5rem; height: 0.09375rem; background: currentColor; transition: transform 180ms ease; }
    .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(0.234375rem) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-0.234375rem) rotate(-45deg); }
    .mobile-nav:not([hidden]) { display: flex; position: absolute; top: 5.5rem; left: 1.25rem; right: 1.25rem; z-index: 5; flex-direction: column; gap: 0.5rem; padding: 1.5rem; color: var(--navy); background: var(--cream); border-radius: 1.125rem; box-shadow: 0 1.5rem 3.75rem rgb(0 0 0 / .3); transform-origin: top right; }
    .mobile-nav :is(button, a) { position: relative; display: block; font-size: 1.5rem; padding: 0.875rem 0.75rem; border-radius: 0.5rem; transition: background-color 250ms ease, padding-left 350ms ease; }
    .mobile-nav :is(button, a)::after { content: '↗'; position: absolute; right: 0.75rem; opacity: 0; transition: opacity 250ms ease; }
    .mobile-nav :is(button, a):is(:hover, :focus-visible) { background: #eae1c1; padding-left: 1.25rem; }
    .mobile-nav :is(button, a):is(:hover, :focus-visible)::after { opacity: 1; }
    .hero__content { left: 1.5rem; right: 1.5rem; bottom: max(2.25rem, env(safe-area-inset-bottom)); display: flex; flex-direction: column-reverse; gap: 2.125rem; }
    .hero__intro h1 {font-size:clamp(2.375rem,8.7vw,4.125rem);}
    .hero__intro p { margin-top: 1.375rem; font-size: 1rem; max-width: 32.5rem; line-height: 1.6; }
    .hero__destinations { padding: 0; gap: 1.75rem; }
    .hero__destinations nav { gap: 0.625rem; }
    .hero__destinations :is(button, a) { font-size: 0.875rem; letter-spacing: 0; }
  }
  @media (max-width: 23.75rem) { .site-header { padding-inline: 1rem; gap: 0.625rem; } .hero__content { left: 1.25rem; right: 1.25rem; } }
  @media (prefers-reduced-motion: reduce) { .menu-toggle span, .mobile-nav :is(button, a), .mobile-nav :is(button, a)::after, .desktop-nav :is(button, a), .desktop-nav :is(button, a)::after, .hero__destinations a, .hero__destinations a::after { transition: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .site-logo, .header-booking { animation: hero-enter 700ms cubic-bezier(.22, 1, .36, 1) both; }
    .desktop-nav > :is(button, a) { animation: nav-item-enter 1000ms cubic-bezier(.16, 1, .3, 1) both; }
    .desktop-nav > :nth-child(1) { animation-delay: 100ms; }
    .desktop-nav > :nth-child(2) { animation-delay: 220ms; }
    .desktop-nav > :nth-child(3) { animation-delay: 340ms; }
    .desktop-nav > :nth-child(4) { animation-delay: 460ms; }
    .mobile-nav:not([hidden]) { animation: menu-open 650ms cubic-bezier(.16, 1, .3, 1) both; }
    .mobile-nav:not([hidden]) > :is(button, a) { animation: menu-item-enter 750ms cubic-bezier(.16, 1, .3, 1) both; }
    .mobile-nav > :nth-child(1) { animation-delay: 140ms; }
    .mobile-nav > :nth-child(2) { animation-delay: 220ms; }
    .mobile-nav > :nth-child(3) { animation-delay: 300ms; }
    .mobile-nav > :nth-child(4) { animation-delay: 380ms; }
    .header-booking { animation-delay: 160ms; }
    .hero__heading-line { animation: hero-enter 900ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__heading-line:nth-of-type(1) { animation-delay: 280ms; }
    .hero__heading-line:nth-of-type(2) { animation-delay: 400ms; }
    .hero__intro p { animation: hero-enter 850ms 520ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__destinations nav a { animation: hero-enter 700ms cubic-bezier(.22, 1, .36, 1) both; }
    .hero__destinations nav a:nth-child(1) { animation-delay: 440ms; }
    .hero__destinations nav a:nth-child(2) { animation-delay: 520ms; }
    .hero__destinations nav a:nth-child(3) { animation-delay: 600ms; }
    .hero__destinations > :global(.booking-link) { animation: hero-enter 750ms 700ms cubic-bezier(.22, 1, .36, 1) both; }
  }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(1.25rem); } to { opacity: 1; transform: translateY(0); } }
  @keyframes nav-item-enter { from { opacity: 0; transform: translateY(-2.25rem); filter: blur(0.5rem); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  @keyframes menu-open { from { opacity: 0; clip-path: inset(0 0 100% 35% round 1.125rem); transform: translateY(-0.75rem) scale(.94); } to { opacity: 1; clip-path: inset(0 0 0 0 round 1.125rem); transform: translateY(0) scale(1); } }
  @keyframes menu-item-enter { from { opacity: 0; transform: translateY(1.75rem); filter: blur(0.3125rem); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
</style>

