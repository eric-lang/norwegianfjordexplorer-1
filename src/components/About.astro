---
import BookingLink from './BookingLink.astro';
---
<section class="about" id="about" aria-labelledby="about-heading">
  <header class="about__header">
    <p class="about__label" data-reveal><span aria-hidden="true"></span>About</p>
    <h2 id="about-heading" data-reveal><em>Captain Mads</em> Is<br />Your Host.</h2>
  </header>
  <div class="about__layout">
    <div class="about__photo" data-reveal>
      <img src="/images/captain-and-crew.webp" alt="Captain Mads welcomes you with his crew beside the explorer vessel" width="1394" height="1000" loading="lazy" />
    </div>
    <div class="about__content">
      <p class="about__welcome" data-reveal style="--reveal-delay:100ms">Welcome to My World!<br />The Team on Tour, Come and Join Us.</p>
      <div class="about__story" data-reveal style="--reveal-delay:180ms">
        <p>Mads comes from a family rich in traditions and is also the captain in the TV series.</p>
        <p>You are very welcome to come and say hello in the wheelhouse, learn about polar navigation, and hear the stories.</p>
        <BookingLink variant="red" hover="navy" />
      </div>
    </div>
  </div>
</section>
<style>
  .about {padding:7.5rem 1rem;background:var(--cream);color:var(--navy);}
  .about__header {margin-bottom:2rem;}
  .about__label {display:flex;align-items:center;justify-content:flex-end;gap:0.75rem;border-bottom:0.0625rem solid rgb(27 54 97 / .25);margin:0 0 0.625rem;padding-bottom:1rem;font:500 1.125rem/1.5 var(--font-body);}
  .about__label span {width:0.625rem;height:0.625rem;background:var(--red);}
  .about h2 {max-width:62.5rem;margin:0;color:#1e1e1e;font:400 clamp(3.25rem,8.333vw,7.5rem)/1.1 Georgia,serif;letter-spacing:-.045em;}
  .about h2 em {font-weight:400;}
  .about__layout {display:grid;grid-template-columns:958fr 386fr;gap:4rem;align-items:stretch;}
  .about__photo {aspect-ratio:958/661;overflow:hidden;border-radius:0.3125rem;}
  .about__photo img {display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.035);transition:transform 900ms cubic-bezier(.22,1,.36,1);}
  .about__photo:hover img {transform:scale(1);}
  .about__content {display:flex;flex-direction:column;justify-content:space-between;gap:2.5rem;min-width:0;}
  .about__welcome {margin:0;color:var(--red);font:400 2rem/1.4 Georgia,serif;letter-spacing:-.045em;}
  .about__story p {margin:0 0 0.625rem;font:700 1.125rem/1.5 var(--font-body);}
  .about__story :global(.booking-link) {margin-top:1.375rem;}
  @media(max-width:62.5rem) and (min-width:47.5625rem) {.about__layout {gap:2rem;grid-template-columns:2fr 1fr;}.about__welcome {font-size:1.6875rem;}.about__story p {font-size:1rem;}}
  @media(max-width:47.5rem) {.about {padding:4rem 1rem;}.about__label {font-size:0.875rem;}.about h2 {font-size:clamp(2.75rem,8.8vw,4.125rem);}.about__layout {grid-template-columns:1fr;gap:1.75rem;}.about__content {gap:1.75rem;}.about__welcome {font-size:1.75rem;}.about__story p {font-size:1rem;}}
  @media(prefers-reduced-motion:reduce) {.about__photo img {transition:none;transform:none;}}
</style>
