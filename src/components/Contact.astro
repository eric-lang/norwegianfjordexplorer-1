<section class="contact" id="contact" aria-labelledby="contact-heading">
  <img class="contact__background" src="/images/contact-sunset.webp" alt="" width="1800" height="1200" loading="lazy" />
  <div class="contact__shade" aria-hidden="true"></div>
  <div class="contact__layout">
    <div class="contact__information">
      <header data-reveal>
        <p class="contact__label"><span aria-hidden="true"></span>Contact</p>
        <h2 id="contact-heading">Or Maybe Just<br /><em>Contact Us?</em></h2>
      </header>
      <div class="contact__details" data-reveal>
        <div id="contact-address"><h3>Address:</h3><p><strong>Ship’s Dock:</strong><br />Dockside of the land office.<br />Bus stop Nerstranda, 9008 Tromsø.</p><p><strong>Land Office:</strong><br />Norwegian Fjord Explorer Line AS<br />Strandgata 9, 9008 Tromsø, Norway.</p><a href="#contact-address">Find Us <span aria-hidden="true">↗</span></a></div>
        <div id="contact-details"><h3>Call Us:</h3><p><strong>Onboard:</strong><br /><a href="#contact-form">+47 947 91 130</a></p><p><strong>Group Travel:</strong><br /><a href="#contact-form">+47 921 63 985</a></p><p><strong>Write an Email:</strong><br /><a class="contact__email" href="#contact-form">booking@norwegianfjordexplorer.com</a></p></div>
      </div>
    </div>
    <form id="contact-form" class="contact__form" data-reveal style="--reveal-delay:120ms" action="mailto:booking@norwegianfjordexplorer.com" method="post" enctype="text/plain">
      <div><label for="contact-name">Name:</label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required /></div>
      <div><label for="contact-email">Email:</label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
      <div><label for="contact-phone">Phone: <span>(optional)</span></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" /></div>
      <div><label for="contact-message">Message:</label><textarea id="contact-message" name="message" rows="6" maxlength="2500" required></textarea></div>
      <button type="submit">Prepare Email <span aria-hidden="true">↗</span></button>
      <p class="contact__form-note">Opens your email app with your enquiry ready to review and send.</p>
      <p class="contact__status" role="status" hidden></p>
    </form>
  </div>
</section>
<script>
  const form=document.querySelector<HTMLFormElement>('.contact__form');
  form?.addEventListener('submit',event=>{
    event.preventDefault();
    if(!form.reportValidity())return;
    const data=new FormData(form);
    const name=String(data.get('name')??'').trim();
    const body=`Hello Norwegian Fjord Explorer,\n\n${String(data.get('message')??'').trim()}\n\nName: ${name}\nEmail: ${data.get('email')}\nPhone: ${String(data.get('phone')??'').trim()||'Not provided'}`;
    const url=`mailto:booking@norwegianfjordexplorer.com?subject=${encodeURIComponent(`Cruise enquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
    const status=form.querySelector<HTMLElement>('.contact__status')!;
    status.textContent='Your email draft is ready. Review and send it in your email app. If it did not open, use the booking email link alongside the form.';
    status.hidden=false;
    window.location.href=url;
  });
</script>
<style>
  .contact {position:relative;padding:7.5rem 1rem;color:#fff;background:#0f1f38;overflow:hidden;}
  .contact__background {position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .contact__shade {position:absolute;inset:0;background:linear-gradient(180deg,rgb(0 0 0 / .7),rgb(0 0 0 / .4) 55%,rgb(0 0 0 / .45));}
  .contact__layout {position:relative;display:grid;grid-template-columns:1.18fr 1fr;gap:clamp(2.5rem,8vw,7.5rem);}
  .contact__information {display:flex;flex-direction:column;justify-content:space-between;gap:5rem;min-width:0;}
  .contact__label {display:flex;align-items:center;gap:0.75rem;margin:0 0 1rem;padding-bottom:1rem;border-bottom:0.0625rem solid rgb(255 255 255 / .2);max-width:29.375rem;font:500 1.125rem/1.5 var(--font-body);}
  .contact__label span {width:0.625rem;height:0.625rem;background:var(--red);}
  .contact h2 {margin:0;font:400 clamp(2.625rem,5vw,4.5rem)/1.1 Georgia,serif;letter-spacing:-.045em;}
  .contact__details {display:grid;grid-template-columns:1fr 1fr;gap:2rem;}
  .contact__details h3 {margin:0 0 1rem;font:400 2.5rem/1.2 Georgia,serif;letter-spacing:-.045em;}
  .contact__details p {margin:0 0 0.875rem;font:500 1.125rem/1.5 var(--font-body);}
  .contact__details strong {font-weight:500;}
  .contact__details a {text-decoration:none;line-height:1.5;}
  .contact__details a:hover {text-decoration:underline;text-underline-offset:0.25rem;}
  .contact__email {overflow-wrap:anywhere;}
  .contact__form {padding:1.5rem;background:rgb(0 0 0 / .55);border-radius:0.3125rem;display:flex;flex-direction:column;gap:2rem;min-width:0;}
  .contact__form label {display:block;margin-bottom:0.75rem;font-size:1.125rem;line-height:1.5;}
  .contact__form label span {font-size:0.875rem;opacity:.8;}
  .contact__form input,.contact__form textarea {display:block;width:100%;border:0.0625rem solid transparent;border-radius:0.25rem;padding:0.625rem 0.75rem;color:var(--navy);background:#eae1c1;font:500 1.125rem/1.5 var(--font-body);}
  .contact__form input {height:2.75rem;}
  .contact__form textarea {min-height:11.25rem;resize:vertical;}
  .contact__form input:focus,.contact__form textarea:focus {outline:0.125rem solid var(--cream);outline-offset:0.1875rem;}
  .contact__form button {display:flex;align-items:center;justify-content:center;gap:0.75rem;width:100%;min-height:2.75rem;padding:0.625rem 1.5rem;border:0;border-radius:62.4375rem;background:var(--red);color:var(--cream);font-size:0.8125rem;font-weight:700;cursor:pointer;transition:color 220ms,background 220ms;}
  .contact__form button:is(:hover,:focus-visible) {background:var(--cream);color:var(--navy);}
  .contact__form-note,.contact__status {margin:-1rem 0 0;font-size:0.8125rem;line-height:1.5;}
  [hidden] {display:none!important;}
  @media(max-width:62.5rem) and (min-width:47.5625rem) {.contact__layout {gap:2rem;}.contact__details {grid-template-columns:1fr;gap:1.25rem;}.contact__information {gap:2.5rem;}.contact__details p {font-size:1rem;}}
  @media(max-width:47.5rem) {.contact {padding:4rem 1rem;}.contact__layout {grid-template-columns:1fr;gap:2.25rem;}.contact__information {gap:2.25rem;}.contact__label {font-size:0.875rem;}.contact__details {grid-template-columns:1fr;gap:1.5rem;}.contact__details h3 {font-size:2rem;}.contact__details p {font-size:1rem;}.contact__form {padding:1.25rem;gap:1.5rem;}.contact__form label {font-size:1rem;}.contact__form input,.contact__form textarea {font-size:1rem;}.contact__form-note,.contact__status {margin-top:-0.5rem;}}
  @media(prefers-reduced-motion:reduce) {.contact__form button {transition:none;}}
</style>
