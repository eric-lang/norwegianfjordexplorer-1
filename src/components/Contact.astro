<section class="contact" id="contact" aria-labelledby="contact-heading">
  <img class="contact__background" src="/images/contact-sunset.webp" alt="" width="1800" height="1200" loading="lazy" />
  <div class="contact__shade" aria-hidden="true"></div>
  <div class="contact__layout">
    <div class="contact__information">
      <header data-reveal>
        <p class="contact__label"><span aria-hidden="true"></span>Contact</p>
        <h2 id="contact-heading">Or Maybe Just<br /><em>Contact Us?</em></h2>
      </header>
      <div class="contact__details" data-reveal>
        <div id="contact-address"><h3>Address:</h3><p><strong>Ship’s Dock:</strong><br />Dockside of the land office.<br />Bus stop Nerstranda, 9008 Tromsø.</p><p><strong>Land Office:</strong><br />Norwegian Fjord Explorer Line AS<br />Strandgata 9, 9008 Tromsø, Norway.</p><a href="#contact-address">Find Us <span aria-hidden="true">↗</span></a></div>
        <div id="contact-details"><h3>Call Us:</h3><p><strong>Onboard:</strong><br /><a href="#contact-form">+47 947 91 130</a></p><p><strong>Group Travel:</strong><br /><a href="#contact-form">+47 921 63 985</a></p><p><strong>Write an Email:</strong><br /><a class="contact__email" href="#contact-form">booking@norwegianfjordexplorer.com</a></p></div>
      </div>
    </div>
    <form id="contact-form" class="contact__form" data-reveal style="--reveal-delay:120ms" action="mailto:booking@norwegianfjordexplorer.com" method="post" enctype="text/plain">
      <div><label for="contact-name">Name:</label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required /></div>
      <div><label for="contact-email">Email:</label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
      <div><label for="contact-phone">Phone: <span>(optional)</span></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" /></div>
      <div><label for="contact-message">Message:</label><textarea id="contact-message" name="message" rows="6" maxlength="2500" required></textarea></div>
      <button type="submit">Prepare Email <span aria-hidden="true">↗</span></button>
      <p class="contact__form-note">Opens your email app with your enquiry ready to review and send.</p>
      <p class="contact__status" role="status" hidden></p>
    </form>
  </div>
</section>
<script>
  const form=document.querySelector<HTMLFormElement>('.contact__form');
  form?.addEventListener('submit',event=>{
    event.preventDefault();
    if(!form.reportValidity())return;
    const data=new FormData(form);
    const name=String(data.get('name')??'').trim();
    const body=`Hello Norwegian Fjord Explorer,\n\n${String(data.get('message')??'').trim()}\n\nName: ${name}\nEmail: ${data.get('email')}\nPhone: ${String(data.get('phone')??'').trim()||'Not provided'}`;
    const url=`mailto:booking@norwegianfjordexplorer.com?subject=${encodeURIComponent(`Cruise enquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
    const status=form.querySelector<HTMLElement>('.contact__status')!;
    status.textContent='Your email draft is ready. Review and send it in your email app. If it did not open, use the booking email link alongside the form.';
    status.hidden=false;
    window.location.href=url;
  });
</script>
<style>
  .contact {position:relative;padding:120px 16px;color:#fff;background:#0f1f38;overflow:hidden;}
  .contact__background {position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .contact__shade {position:absolute;inset:0;background:linear-gradient(180deg,rgb(0 0 0 / .7),rgb(0 0 0 / .4) 55%,rgb(0 0 0 / .45));}
  .contact__layout {position:relative;display:grid;grid-template-columns:1.18fr 1fr;gap:clamp(40px,8vw,120px);}
  .contact__information {display:flex;flex-direction:column;justify-content:space-between;gap:80px;min-width:0;}
  .contact__label {display:flex;align-items:center;gap:12px;margin:0 0 16px;padding-bottom:16px;border-bottom:1px solid rgb(255 255 255 / .2);max-width:470px;font:500 18px/1.5 var(--font-body);}
  .contact__label span {width:10px;height:10px;background:var(--red);}
  .contact h2 {margin:0;font:400 clamp(42px,5vw,72px)/1.1 Georgia,serif;letter-spacing:-.045em;}
  .contact__details {display:grid;grid-template-columns:1fr 1fr;gap:32px;}
  .contact__details h3 {margin:0 0 16px;font:400 40px/1.2 Georgia,serif;letter-spacing:-.045em;}
  .contact__details p {margin:0 0 14px;font:500 18px/1.5 var(--font-body);}
  .contact__details strong {font-weight:500;}
  .contact__details a {text-decoration:none;line-height:1.5;}
  .contact__details a:hover {text-decoration:underline;text-underline-offset:4px;}
  .contact__email {overflow-wrap:anywhere;}
  .contact__form {padding:24px;background:rgb(0 0 0 / .55);border-radius:5px;display:flex;flex-direction:column;gap:32px;min-width:0;}
  .contact__form label {display:block;margin-bottom:12px;font-size:18px;line-height:1.5;}
  .contact__form label span {font-size:14px;opacity:.8;}
  .contact__form input,.contact__form textarea {display:block;width:100%;border:1px solid transparent;border-radius:4px;padding:10px 12px;color:var(--navy);background:#eae1c1;font:500 18px/1.5 var(--font-body);}
  .contact__form input {height:44px;}
  .contact__form textarea {min-height:180px;resize:vertical;}
  .contact__form input:focus,.contact__form textarea:focus {outline:2px solid var(--cream);outline-offset:3px;}
  .contact__form button {display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:44px;padding:10px 24px;border:0;border-radius:999px;background:var(--red);color:var(--cream);font-size:13px;font-weight:700;cursor:pointer;transition:color 220ms,background 220ms;}
  .contact__form button:is(:hover,:focus-visible) {background:var(--cream);color:var(--navy);}
  .contact__form-note,.contact__status {margin:-16px 0 0;font-size:13px;line-height:1.5;}
  [hidden] {display:none!important;}
  @media(max-width:1000px) and (min-width:761px) {.contact__layout {gap:32px;}.contact__details {grid-template-columns:1fr;gap:20px;}.contact__information {gap:40px;}.contact__details p {font-size:16px;}}
  @media(max-width:760px) {.contact {padding:64px 16px;}.contact__layout {grid-template-columns:1fr;gap:36px;}.contact__information {gap:36px;}.contact__label {font-size:14px;}.contact__details {grid-template-columns:1fr;gap:24px;}.contact__details h3 {font-size:32px;}.contact__details p {font-size:16px;}.contact__form {padding:20px;gap:24px;}.contact__form label {font-size:16px;}.contact__form input,.contact__form textarea {font-size:16px;}.contact__form-note,.contact__status {margin-top:-8px;}}
  @media(prefers-reduced-motion:reduce) {.contact__form button {transition:none;}}
</style>
